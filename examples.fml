
// FML

shared {
    let variable: Integer = 1;
    let variable2: Array<Bool, 2> = [True, False];
}

let x = 10;

spawn {
    aquire variable {
        variable = variable + 1;
    }

    spawn {
        aquire variable {
            variable = variable + 1;
        }
    }
} do {
    spawn {
        aquire variable {
            variable = variable + 1;
        }
    } do {
        print(10);
    }

    x = 10;
}


aquire variable {
    print(variable);
}