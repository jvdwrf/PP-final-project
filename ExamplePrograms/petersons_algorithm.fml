
shared {
    let queue = 0;
    let hasValue = False;
}


spawn {
    // Consumer 1: prints whenever there is a value
    while True {
        sleep(100);
        acquire hasValue {
            if hasValue {
                hasValue = False;
                print(queue);
            }
        }
    }
} do {
    spawn {
        // Consumer 2: prints whenever there is a value
        while True {
            sleep(100);
            acquire hasValue {
                if hasValue {
                    hasValue = False;
                    print(queue);
                }
            }
        }
    } do {
        spawn {
            // Producer 1: Counts up from 0
            let x = 0;
            while True {
                sleep(100000);
                acquire hasValue {
                    if hasValue == False {
                        queue = x;
                        hasValue = True;
                        x = x + 1;
                    }
                }
            }
        } do {
            let x = 100;
            // Producer 2: counts down from 100
            while True {
                sleep(100000);
                acquire hasValue {
                    if hasValue == False {
                        queue = x;
                        hasValue = True;
                        x = x - 1;
                    }
                }
            }
        }
    }
}

// EXPECTED OUTPUT:
// Sprockel 1 and 2 should both print values 0 up and 100 down, but no value should
// ever be repeated. This implements a multi-consumer multi-producer one value queue.
//
// This program will never terminate