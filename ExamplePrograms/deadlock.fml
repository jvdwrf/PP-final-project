shared {
    let account1 = 100;
    let account2 = 50;
}


spawn {
    // acquire 1 then 2
    acquire account1 {
        print(1);
        sleep(1000);
        acquire account2 {
            print(2);
        }
    }
} do {
    // acquire 2 then 1
    acquire account2 {
        print(2);
        sleep(1000);
        acquire account1 {
            print(1);
        }
    }
}

// EXPECTED OUTPUT:
// This should deadlock.
//
// Sprockel 0 says 2
// Sprockel 1 says 1